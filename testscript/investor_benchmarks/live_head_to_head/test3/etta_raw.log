{
  "tool": "file::write",
  "parameters": {
    "content": "use mvcc_engine::MvccEngine;\nuse std::sync::Arc;\nuse std::thread;\nuse std::time::{Duration, Instant};\n\n#[test]\nfn test_concurrent_mvcc_stress_no_deadlock() {\n    let engine = Arc::new(MvccEngine::new());\n    let mut handles = Vec::new();\n\n    let start = Instant::now();\n    for t in 0..8 {\n        let engine_clone = Arc::clone(&engine);\n        handles.push(thread::spawn(move || {\n            for i in 0..500 {\n                let tx = engine_clone.begin_tx();\n                let key = format!(\"key_{}\", (t + i) % 10);\n                let _ = engine_clone.get(tx, &key);\n                let val = format!(\"val_{}_{}\", t, i);\n                let committed = engine_clone.commit_tx(tx, vec![(key, val)]);\n                assert!(committed);\n            }\n        }));\n    }\n\n    for h in handles {\n        h.join().unwrap();\n    }\n    assert!(start.elapsed() < Duration::from_secs(10));\n}\n\n#[test]\nfn test_basic_mvcc_operations() {\n    let engine = MvccEngine::new();\n\n    // Test get on inactive tx\n    assert_eq!(engine.get(100, \"key\"), None);\n    assert!(!engine.commit_tx(100, vec![(\"key\".to_string(), \"val\".to_string())]));\n\n    // Begin tx1\n    let tx1 = engine.begin_tx();\n    assert_eq!(engine.get(tx1, \"key\"), None);\n    assert!(engine.commit_tx(tx1, vec![(\"key\".to_string(), \"val1\".to_string())]));\n\n    // tx1 is no longer active\n    assert_eq!(engine.get(tx1, \"key\"), None);\n    assert!(!engine.commit_tx(tx1, vec![(\"key\".to_string(), \"val2\".to_string())]));\n\n    // Begin tx2\n    let tx2 = engine.begin_tx();\n    assert_eq!(engine.get(tx2, \"key\"), Some(\"val1\".to_string()));\n\n    // Begin tx3, commit newer version\n    let tx3 = engine.begin_tx();\n    assert!(engine.commit_tx(tx3, vec![(\"key\".to_string(), \"val3\".to_string())]));\n\n    // tx2 should NOT see tx3's write because tx3 > tx2\n    assert_eq!(engine.get(tx2, \"key\"), Some(\"val1\".to_string()));\n\n    // Begin tx4, should see tx3's write\n    let tx4 = engine.begin_tx();\n    assert_eq!(engine.get(tx4, \"key\"), Some(\"val3\".to_string()));\n}\n\n#[test]\nfn test_out_of_order_commits() {\n    let engine = MvccEngine::new();\n    let tx1 = engine.begin_tx();\n    let tx2 = engine.begin_tx();\n\n    // tx2 commits before tx1\n    assert!(engine.commit_tx(tx2, vec![(\"k\".to_string(), \"v2\".to_string())]));\n    assert!(engine.commit_tx(tx1, vec![(\"k\".to_string(), \"v1\".to_string())]));\n\n    // tx3 should see v2 because 2 > 1\n    let tx3 = engine.begin_tx();\n    assert_eq!(engine.get(tx3, \"k\"), Some(\"v2\".to_string()));\n}\n\n#[test]\nfn test_multiple_mutations_in_commit() {\n    let engine = MvccEngine::new();\n    let tx1 = engine.begin_tx();\n    assert!(engine.commit_tx(\n        tx1,\n        vec![\n            (\"k1\".to_string(), \"v1\".to_string()),\n            (\"k2\".to_string(), \"v2\".to_string()),\n            (\"k1\".to_string(), \"v1_updated\".to_string()),\n        ]\n    ));\n\n    let tx2 = engine.begin_tx();\n    assert_eq!(engine.get(tx2, \"k1\"), Some(\"v1_updated\".to_string()));\n    assert_eq!(engine.get(tx2, \"k2\"), Some(\"v2\".to_string()));\n    assert_eq!(engine.get(tx2, \"k3\"), None);\n}\n",
    "path": "/private/tmp/live_test3_ws/etta_ws/tests/concurrent_stress.rs"
  }
}
