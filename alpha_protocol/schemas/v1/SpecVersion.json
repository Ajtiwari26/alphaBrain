{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "Decision": {
      "properties": {
        "dec_id": {
          "title": "Dec Id",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "alternatives_considered": {
          "items": {
            "type": "string"
          },
          "title": "Alternatives Considered",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "dec_id",
        "topic",
        "decision",
        "rationale"
      ],
      "title": "Decision",
      "type": "object"
    },
    "OpenQuestion": {
      "properties": {
        "question_id": {
          "title": "Question Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "context": {
          "title": "Context",
          "type": "string"
        },
        "owner": {
          "default": "founder",
          "title": "Owner",
          "type": "string"
        },
        "resolved": {
          "default": false,
          "title": "Resolved",
          "type": "boolean"
        },
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Answer"
        }
      },
      "required": [
        "question_id",
        "question",
        "context"
      ],
      "title": "OpenQuestion",
      "type": "object"
    },
    "Requirement": {
      "properties": {
        "req_id": {
          "title": "Req Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "raw_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Direct quote from meeting transcript or client message",
          "title": "Raw Quote"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "priority": {
          "default": "medium",
          "description": "must_have, should_have, nice_to_have",
          "title": "Priority",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "req_id",
        "title",
        "description"
      ],
      "title": "Requirement",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": 1,
      "description": "Sequential spec version number",
      "title": "Version",
      "type": "integer"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "requirements": {
      "items": {
        "$ref": "#/$defs/Requirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "open_questions": {
      "items": {
        "$ref": "#/$defs/OpenQuestion"
      },
      "title": "Open Questions",
      "type": "array"
    },
    "architecture_overview": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Architecture Overview"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "pending"
    },
    "founder_approved": {
      "default": false,
      "title": "Founder Approved",
      "type": "boolean"
    },
    "client_approved": {
      "default": false,
      "title": "Client Approved",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "approved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Approved At"
    }
  },
  "required": [
    "project_id",
    "title",
    "summary"
  ],
  "title": "SpecVersion",
  "type": "object"
}