# Alpha Brain Environment Configuration

# Environment & Debug
ENV=development
DEBUG=false

# Authentication and network boundaries
ALPHA_API_TOKEN=replace_with_at_least_32_random_characters
ALPHA_WORKER_TOKEN=replace_with_a_different_32_character_token
ALPHA_SIGNING_SECRET=replace_with_at_least_32_random_characters
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Model Credentials (Provided by User)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Aoede

# Telephony (Plivo Credentials provided by User)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=your_plivo_phone_number_here

# Stitch MCP Configuration
STITCH_MODEL_ID=gemini-3.1-pro

# Database Configuration. Production: Supabase/Render Postgres session-pooler URL (port 5432).
# Current code does not require Redis; add Upstash only when queue/cache scale needs it.
DATABASE_URL=sqlite+aiosqlite:///alpha_brain.db

# Local Temporal Orchestrator
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Local Paths & Hardware
MEMORY_GRAPH_PATH=/Users/ajaytiwari/Desktop/Projects/memory_graph
WORKTREE_BASE_DIR=/Users/ajaytiwari/Library/Application Support/AlphaBrain/worktrees
ANTIGRAVITY_EXECUTION_ENABLED=true
ANTIGRAVITY_MODEL=gemini-3.1-pro-high
ANTIGRAVITY_EFFORT=high
ANTIGRAVITY_UNATTENDED_COMMANDS=false
ANTIGRAVITY_CLI_BIN=/Users/ajaytiwari/.local/bin/agy
ANTIGRAVITY_SDLC_SKILL_PATH=/Users/ajaytiwari/.gemini/antigravity/skills/multi-agent-sdlc/SKILL.md
ANTIGRAVITY_TASK_TIMEOUT_SECONDS=1200
WORKER_LEASE_DURATION_SECONDS=1800
# Alpha Brain creates project-scoped conversations, then requires AGY QA audit/repair before success.
# Optional migration override for an existing dedicated project conversation ID.
ALPHA_BRAIN_ANTIGRAVITY_CONVERSATION_ID=
ATTACHED_DEVICE_ID=10BF5P2AZF0010T
ALLOWED_REPO_ROOTS=/Users/ajaytiwari/Desktop/Projects
ALLOWED_GATE_EXECUTABLES=pytest,ruff,mypy,node,npm,npx,pnpm,yarn,swift,xcodebuild,cargo,go

# P5 outbound Mac worker. Production uses Keychain values, never this file.
WORKER_CONTROL_PLANE_URL=https://alpha.example.com
WORKER_ID=mac_worker_local
WORKER_IDENTITY_TOKEN=
WORKER_STATE_DIR=/Users/ajaytiwari/Library/Application Support/AlphaBrain/worker
WORKER_SPOOL_FERNET_KEY=
WORKER_HTTP_TIMEOUT_SECONDS=15
WORKER_HEARTBEAT_SECONDS=60
WORKER_ALLOW_LOCAL_DB=true
WORKER_USE_KEYCHAIN=false
WORKER_KEYCHAIN_SERVICE=com.deploymate.alphabrain
WORKTREE_MAX_DISK_GB=100
WORKTREE_MIN_FREE_GB=20

# LiveKit Open Source / Cloud
# Local example only. Generate unique production credentials; never deploy these placeholders.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=alphabrainlocalkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
