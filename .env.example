# Alpha Brain Environment Configuration

# Environment & Debug
ENV=development
DEBUG=false

# Authentication and network boundaries
ALPHA_API_TOKEN=replace_with_at_least_32_random_characters
ALPHA_WORKER_TOKEN=replace_with_a_different_32_character_token
ALPHA_SIGNING_SECRET=replace_with_at_least_32_random_characters
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Model Credentials (Provided by User)
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede

# Telephony (Plivo Credentials provided by User)
PLIVO_AUTH_ID=your_plivo_auth_id_here
PLIVO_AUTH_TOKEN=your_plivo_auth_token_here
PLIVO_PHONE_NUMBER=your_plivo_phone_number_here

# Stitch MCP Configuration
STITCH_MODEL_ID=gemini-3.1-pro

# Database Configuration (Defaults to local SQLite if Postgres not running)
DATABASE_URL=sqlite+aiosqlite:///alpha_brain.db

# Local Temporal Orchestrator
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Local Paths & Hardware
MEMORY_GRAPH_PATH=/Users/ajaytiwari/Desktop/Projects/memory_graph
WORKTREE_BASE_DIR=/Users/ajaytiwari/Library/Application Support/AlphaBrain/worktrees
ATTACHED_DEVICE_ID=10BF5P2AZF0010T
ALLOWED_REPO_ROOTS=/Users/ajaytiwari/Desktop/Projects
ALLOWED_GATE_EXECUTABLES=pytest,ruff,mypy,npm,npx,pnpm,yarn,swift,xcodebuild,cargo,go
ALLOWED_CLAUDE_TOOLS=Read,Edit,Write

# LiveKit Open Source / Cloud
# Local example only. Generate unique production credentials; never deploy these placeholders.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=alphabrainlocalkey
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
